# Contact form email delivery (see README for setup)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
CONTACT_TO_EMAIL=cinis@csocs.com.au

# Contact form datasheet: appends every enquiry as a row in a Google Sheet
# (see README for how to create the service account and share the sheet)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=the-id-from-your-sheet-url
GOOGLE_SHEET_NAME=Enquiries
